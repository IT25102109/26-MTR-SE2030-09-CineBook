# CineBook Frontend Environment Configuration

# Backend API Base URL (defaults to http://localhost:8080/api if omitted)
VITE_API_URL=http://localhost:8080/api

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Make sure to add Authorized JavaScript Origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

